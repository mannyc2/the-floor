{
  "$schema": "../../../../node_modules/wrangler/config-schema.json",
  "name": "floor-platform-local-probe",
  "main": "bare-worker.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": [
    "no_nodejs_compat",
    "no_nodejs_compat_v2",
  ],
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "JOURNAL",
        "class_name": "JournalProbe",
      },
      {
        "name": "ALARMS",
        "class_name": "AlarmProbe",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "JournalProbe",
        "AlarmProbe",
      ],
    },
  ],
  "d1_databases": [
    {
      "binding": "HISTORY",
      "database_name": "floor-platform-local-history",
      "database_id": "00000000-0000-0000-0000-000000000001",
    },
  ],
}
