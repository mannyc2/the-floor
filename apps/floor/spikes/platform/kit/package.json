{
  "name": "floor-kit-client-spike",
  "private": true,
  "type": "module",
  "dependencies": {
    "@effect/platform-browser": "4.0.3",
    "@solana/kit": "8.4.0",
    "@whetstone-research/doppler-sdk": "1.0.43",
    "alchemy": "2.0.0-beta.80",
    "effect": "4.0.3",
    "viem": "2.44.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261012.1",
    "@codama/nodes-from-anchor": "1.5.6",
    "@codama/renderers-js": "2.5.0",
    "@effect/platform-bun": "4.0.3",
    "@effect/platform-node": "4.0.3",
    "@effect/tsgo": "0.51.1",
    "@types/bun": "1.4.2",
    "codama": "1.11.0",
    "dprint": "0.63.0",
    "effect-oxlint": "0.4.0",
    "oxlint": "1.87.0",
    "oxlint-plugin-effect": "0.28.1",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2"
  },
  "scripts": {
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --type-aware --type-check --deny-warnings -c .oxlintrc.json crypto.ts entry.ts construction.ts config.ts evm.ts math.ts math-probe.ts bounded-instructions.ts bounded-generated local.test.ts local-only.ts src/privy test/privy",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "build": "CI=true ALCHEMY_TELEMETRY_DISABLED=1 bun test --preload ./local-only.ts ./local.test.ts",
    "generate": "bun x --no-install codama run js && python3 bounded-client.py",
    "test": "CI=true ALCHEMY_TELEMETRY_DISABLED=1 bun test --preload ./local-only.ts ./test/privy"
  },
  "patchedDependencies": {
    "alchemy@2.0.0-beta.80": "patches/alchemy@2.0.0-beta.80.patch"
  }
}
