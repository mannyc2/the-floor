{
  "name": "the-floor",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint": "bun build ./scripts/lint/plugin.ts --target=node --external effect --external effect-oxlint --outfile work/lint/plugin.mjs && oxlint --deny-warnings --report-unused-disable-directives apps/web/src apps/web/test apps/web/workbench apps/web/vite.config.ts apps/floor/src apps/floor/test apps/signer/src apps/signer/test packages scripts stacks testing/flows testing/look alchemy.run.ts && bun scripts/lint/styles.ts && bun scripts/lint/suppressions.ts",
    "typecheck": "tsc -b",
    "test": "CI=true ALCHEMY_TELEMETRY_DISABLED=1 bun test ./scripts/lint/test ./scripts/bundle-budget/test ./scripts/ci/test ./packages/contract/test ./packages/world/test ./packages/chains/test ./packages/wallets/test ./testing/look/test ./apps/floor/test/decisions.test.ts ./apps/signer/test/fork-key.test.ts ./apps/web/test",
    "test:native": "sh apps/floor/test/run.sh && sh apps/signer/test/run.sh",
    "build": "bun scripts/lint/styles.ts && vite build --config apps/web/vite.config.ts && bun scripts/bundle-budget/cli.ts && CI=true ALCHEMY_TELEMETRY_DISABLED=1 bun test --preload ./apps/floor/test/local-only.ts ./apps/floor/test/build.test.ts && bun scripts/bundle-budget/modules.ts --directory .alchemy/bundles/FloorWorker && CI=true ALCHEMY_TELEMETRY_DISABLED=1 bun test --preload ./apps/floor/test/local-only.ts ./apps/signer/test/build.test.ts && bun scripts/bundle-budget/modules.ts --directory .alchemy/bundles/SignerWorker && bun build ./packages/chains/src/solana/index.ts ./packages/chains/src/evm/index.ts --root ./packages/chains/src --target browser --sourcemap=external --outdir ./work/chains-bundle && bun scripts/bundle-budget/modules.ts --directory work/chains-bundle",
    "e2e": "playwright test --config testing/flows/playwright.config.ts",
    "dev": "alchemy dev --stage dev",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "preview": "bun scripts/ci/deploy.ts",
    "preview:destroy": "bun scripts/ci/cleanup.ts",
    "ci:configure": "bun scripts/ci/admin.ts",
    "test:signer": "sh apps/signer/test/run.sh",
    "dev:fork": "sh apps/signer/test/install-surfpool.sh && bun apps/signer/test/clone-programs.ts && CI=true ALCHEMY_TELEMETRY_DISABLED=1 bun --preload ./apps/floor/test/local-only.ts apps/signer/test/serve-local.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261012.1",
    "@effect/platform-browser": "4.0.3",
    "@effect/platform-bun": "4.0.3",
    "@effect/platform-node": "4.0.3",
    "@effect/tsgo": "0.51.1",
    "@foldkit/oxlint-plugin": "0.15.3",
    "@foldkit/vite-plugin": "0.27.1",
    "@playwright/test": "1.64.0",
    "@types/bun": "1.4.2",
    "@types/pngjs": "6.0.5",
    "@types/three": "0.180.0",
    "dprint": "0.63.0",
    "effect-oxlint": "0.4.0",
    "oxlint": "1.87.0",
    "oxlint-plugin-effect": "0.28.1",
    "oxlint-tsgolint": "7.0.2003",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "@floor/atlas": "workspace:*"
  },
  "dependencies": {
    "alchemy": "2.0.0-beta.80",
    "effect": "4.0.3",
    "@yielded/agent": "file:vendor/yielded/0adbcff-effect-4.0.3/yielded-agent-0.1.0-beta.166-floor.0adbcff.403.2.tgz",
    "@yielded/agent-storage-sql": "file:vendor/yielded/0adbcff-effect-4.0.3/yielded-agent-storage-sql-0.1.0-beta.166-floor.0adbcff.403.2.tgz",
    "@yielded/agent-storage-cloudflare": "file:vendor/yielded/0adbcff-effect-4.0.3/yielded-agent-storage-cloudflare-0.1.0-beta.166-floor.0adbcff.403.2.tgz",
    "@yielded/agent-platform-cloudflare": "file:vendor/yielded/0adbcff-effect-4.0.3/yielded-agent-platform-cloudflare-0.1.0-beta.166-floor.0adbcff.403.2.tgz",
    "@yielded/agent-platform-alchemy-cloudflare": "file:vendor/yielded/0adbcff-effect-4.0.3/yielded-agent-platform-alchemy-cloudflare-0.1.0-beta.166-floor.0adbcff.403.2.tgz",
    "@yielded/agent-testing": "file:vendor/yielded/0adbcff-effect-4.0.3/yielded-agent-testing-0.1.0-beta.166-floor.0adbcff.403.2.tgz",
    "@floor/app-floor": "workspace:*"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "effect": "4.0.3",
    "@effect/platform-browser": "4.0.3",
    "@effect/platform-bun": "4.0.3",
    "@effect/platform-node": "4.0.3",
    "@effect/platform-node-shared": "4.0.3",
    "@effect/sql-d1": "4.0.3",
    "@effect/sql-sqlite-do": "4.0.3",
    "@effect/ai-openai": "4.0.3",
    "@yielded/agent": "file:vendor/yielded/0adbcff-effect-4.0.3/yielded-agent-0.1.0-beta.166-floor.0adbcff.403.2.tgz",
    "@yielded/agent-storage-sql": "file:vendor/yielded/0adbcff-effect-4.0.3/yielded-agent-storage-sql-0.1.0-beta.166-floor.0adbcff.403.2.tgz",
    "@yielded/agent-storage-cloudflare": "file:vendor/yielded/0adbcff-effect-4.0.3/yielded-agent-storage-cloudflare-0.1.0-beta.166-floor.0adbcff.403.2.tgz",
    "@yielded/agent-platform-cloudflare": "file:vendor/yielded/0adbcff-effect-4.0.3/yielded-agent-platform-cloudflare-0.1.0-beta.166-floor.0adbcff.403.2.tgz",
    "@yielded/agent-platform-alchemy-cloudflare": "file:vendor/yielded/0adbcff-effect-4.0.3/yielded-agent-platform-alchemy-cloudflare-0.1.0-beta.166-floor.0adbcff.403.2.tgz",
    "@yielded/agent-testing": "file:vendor/yielded/0adbcff-effect-4.0.3/yielded-agent-testing-0.1.0-beta.166-floor.0adbcff.403.2.tgz"
  },
  "patchedDependencies": {
    "alchemy@2.0.0-beta.80": "patches/alchemy@2.0.0-beta.80.patch"
  }
}
