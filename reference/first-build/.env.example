FLOOR_HOST=127.0.0.1
PORT=8787
FLOOR_ORIGIN=http://127.0.0.1:8787
FLOOR_LOCAL=true
FLOOR_DATABASE=.data/floor.sqlite
FLOOR_RECORDING=data/base-day.json
FLOOR_HISTORY_BLOCKS=2048
BASE_RPC_URL=https://mainnet.base.org
BASE_LOG_RPC_URL=https://base-rpc.publicnode.com
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Research requires a model and explicit rates as well as the API key.
# OPENAI_API_KEY=
# INFERENCE_MODEL=
# INFERENCE_INPUT_USD_PER_MILLION=
# INFERENCE_OUTPUT_USD_PER_MILLION=
# INFERENCE_API_URL=https://api.openai.com/v1
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=
# BLOCKED_BROWSER_DOMAINS=example.com,example.org

# Visual review uses structured, image-capable inference.
# GATE_MODEL=
# GATE_BROWSER_EXECUTABLE=/absolute/path/to/chrome

# Authorize each owner/account/policy at the scoped signing service first.
# FLOOR_SIGNER_URL=https://your-signing-service.example
# FLOOR_SIGNER_TOKEN=

# Casting requires the deployed Base Sepolia contract and exact immutable terms.
# FLOOR_FOUNDRY_ADDRESS=
# FLOOR_FOUNDRY_TOKEN_SUPPLY=1000000
# FLOOR_FOUNDRY_LAUNCH_FEE_WEI=1000000000000000
# FLOOR_FOUNDRY_GRADUATION_WEI=1000000000000000000
# FLOOR_FOUNDRY_VIRTUAL_LIQUIDITY_WEI=1000000000000000000

# Optional Effect inspector and OpenTelemetry exports.
FLOOR_DEVTOOLS=false
# FLOOR_DEVTOOLS_URL=ws://localhost:34437
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
