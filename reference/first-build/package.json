{
  "name": "the-floor",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "dev:api": "bun --watch packages/server/src/local.ts",
    "typecheck": "tsc --noEmit",
    "lint": "bun run lint:rules && oxlint --deny-warnings --report-unused-disable-directives-severity=error",
    "format": "dprint fmt",
    "build": "vite build && bun build packages/server/src/local.ts --target=bun --outdir=dist/server --external=cloudflare:workers --external=playwright-core",
    "test": "bun --bun node_modules/vitest/vitest.mjs run",
    "test:e2e": "playwright test",
    "test:demo": "playwright test --headed",
    "test:contracts": "forge test --root packages/foundry",
    "check:bundle": "bun run scripts/bundle-budget.ts",
    "bench": "bun run testing/bench/run.ts",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "lint:rules": "bun build scripts/lint/plugin.ts --target=node --packages=external --outfile=node_modules/.cache/floor-lint/plugin.js",
    "start": "bun run dist/server/local.js",
    "format:check": "dprint check"
  },
  "dependencies": {
    "@effect/ai-openai": "4.0.0",
    "@effect/platform-browser": "4.0.0",
    "@effect/platform-bun": "4.0.0",
    "@effect/sql-sqlite-bun": "4.0.0",
    "@yielded/agent": "0.1.0-beta.166",
    "effect": "4.0.0",
    "effect-browser": "0.3.0-beta.14",
    "effect-browserbase": "0.3.0-beta.14",
    "foldkit": "0.168.0",
    "playwright-core": "1.63.0",
    "three": "0.180.0",
    "viem": "2.38.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261012.1",
    "@effect/tsgo": "0.51.1",
    "@effect/vitest": "4.0.0",
    "@foldkit/devtools": "0.168.0",
    "@foldkit/oxlint-plugin": "0.15.3",
    "@foldkit/ui": "0.168.0",
    "@foldkit/vite-plugin": "0.27.1",
    "@playwright/test": "1.64.0",
    "@types/bun": "1.4.2",
    "@types/three": "0.180.0",
    "dprint": "0.63.0",
    "effect-oxlint": "0.4.0",
    "oxlint": "1.87.0",
    "oxlint-plugin-effect": "0.28.1",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
